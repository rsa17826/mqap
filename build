#!/usr/bin/env bash
trap 'rm -f ~/projects/MultiworldGG/output/apworlds/mathquest.apworld; exit 0' TERM
if test -n "$VERSION"; then
  sed -i 's/"world_version": .*,/"world_version": "'"$VERSION"'.0.0",/' archipelago.json
fi
/home/nyix/projects/MultiworldGG/.venv/bin/python3.13 make_apworlds.py mathquest &>/dev/tty
generate-global-tracker-data MathQuest &>/dev/tty
echo ~/projects/MultiworldGG/output/apworlds/mathquest.apworld

while :; do
  sleep 1
done
